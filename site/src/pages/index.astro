---
import Base from "../layouts/Base.astro";
import { APP_URL, REPO_URL, RDS_URL, CITATION_DOI, CITATION_TEXT } from "../config";

// Deterministic faux ignition map (no real data shown).
let seed = 7;
const rnd = () => ((seed = (seed * 16807) % 2147483647) / 2147483647);
const gauss = () => (rnd() + rnd() + rnd() + rnd() - 2) / 2;
const colors = ["#2a78d6", "#eb6834", "#1baf7a", "#eda100", "#e87ba4", "#6250d6"];
const hubs = [
  { x: 140, y: 120, s: 55, n: 90 },
  { x: 210, y: 250, s: 60, n: 70 },
  { x: 520, y: 240, s: 70, n: 110 },
  { x: 620, y: 330, s: 45, n: 70 },
  { x: 380, y: 200, s: 90, n: 60 },
];
const dots = hubs.flatMap((h) =>
  Array.from({ length: h.n }, () => ({
    x: Math.round(h.x + gauss() * h.s * 2.4),
    y: Math.round(h.y + gauss() * h.s * 1.5),
    r: +(1.2 + rnd() * 2.4).toFixed(1),
    c: colors[Math.floor(rnd() * colors.length)],
    d: +(rnd() * 4).toFixed(1),
  }))
);

const features = [
  { t: "Color by cause", d: "General cause, classification, age category, owner, agency, source type, size class, year or month. Click the legend to isolate or hide a value.", i: "M12 3a9 9 0 1 0 9 9c0-1.7-1.3-2-2.5-2H16a2 2 0 0 1-2-2V6c0-1.7-.7-3-2-3z" },
  { t: "Filter anything", d: "Year, day of year, cause, size class, acreage, state, county, owner and agency. Every filter and the viewport live in the URL, so any view is shareable.", i: "M3 5h18l-7 8v6l-4 2v-8z" },
  { t: "Charts that follow the map", d: "Fires per year by category, a month × category heatmap, rankings and size-class distribution. Limit them to the visible extent.", i: "M4 20V10m6 10V4m6 16v-7m4 7H2" },
  { t: "Animate the years", d: "Play 1992 to 2024 at your speed, or switch to cumulative mode to watch ignitions accumulate.", i: "M6 4l14 8-14 8z" },
  { t: "Map the way you want", d: "Fixed, zoom-scaled or fire-size radius. Heatmap weighted by count or size. Light, dark and USGS satellite basemaps.", i: "M9 4 3 6v14l6-2 6 2 6-2V4l-6 2zM9 4v14m6-12v14" },
  { t: "Take the data with you", d: "Export CSV, GeoJSON, Parquet or a PNG. Each file records the filters, date and source, plus the official citation.", i: "M12 3v12m0 0-4-4m4 4 4-4M4 19h16" },
];
const steps = [
  { t: "Open the map", d: "Start from the Lower 48, or jump to Alaska, Hawaii or Puerto Rico." },
  { t: "Slice by cause and time", d: "Pick a color field and narrow with filters. Counts and charts update with the map." },
  { t: "Share or export", d: "Copy the URL for the exact view, or download the filtered records." },
];
const stats = [
  ["33", "years of records, 1992–2024"],
  ["9", "fields to color ignitions by"],
  ["4", "regions: Lower 48, AK, HI, PR"],
  ["4", "export formats"],
];
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---
<Base
  title="FPA-FOD Wildfire Ignitions"
  description="Explore 33 years of U.S. wildfire ignition points by cause, year, size and place. Interactive map, charts and downloads."
>
  <header class="wrap">
    <nav class="nav glass" aria-label="Main">
      <a class="brand" href={`${base}/`}>
        <svg viewBox="0 0 64 64" aria-hidden="true"><rect width="64" height="64" rx="14" fill="#1a1a19"/><path d="M32 8c2.2 8.6 13 14.4 13 27a13 13 0 0 1-26 0c0-6.4 3.2-9.8 6.6-13 0 4.2 2 6.2 4.2 7.2C28.6 19 29.6 13.6 32 8z" fill="#eb6834"/><path transform="translate(0 -1.6)" d="M32 30c1.2 4.4 6.4 7.2 6.4 12.4a6.4 6.4 0 0 1-12.8 0c0-3.2 2-5.2 4.2-6.4 0 2 1 3.2 2.2 3.4-.6-3.6-.6-6.4 0-9.4z" fill="#eda100"/></svg>
        FPA-FOD
      </a>
      <div class="links">
        <a class="hide-sm" href="#features">Features</a>
        <a class="hide-sm" href="#how">How it works</a>
        <a class="hide-sm" href="#data">Data</a>
        <a class="hide-sm" href={REPO_URL}>GitHub</a>
        <button class="icon-btn" data-theme-toggle type="button" aria-label="Toggle light and dark theme">
          <svg class="sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M2 12h2m16 0h2M4.9 19.1l1.4-1.4m11.4-11.4 1.4-1.4"/></svg>
          <svg class="moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 13A9 9 0 1 1 11 3a7 7 0 0 0 10 10z"/></svg>
        </button>
        <a class="btn primary sm" href={APP_URL}>Launch app</a>
      </div>
    </nav>
  </header>

  <main>
    <section class="hero wrap" style="padding-bottom:0">
      <div class="pill glass"><i></i> USFS Research Data Archive · 7th Edition</div>
      <h1>Every U.S. wildfire <em>ignition</em>, on one map.</h1>
      <p class="lede">Explore 33 years of reported fire starts by cause, size, year and place. Filter, chart and download, right in your browser.</p>
      <div class="cta">
        <a class="btn primary" href={APP_URL}>Open the map →</a>
        <a class="btn ghost" href="#features">See what it does</a>
      </div>

      <div class="preview glass" aria-hidden="true">
        <div class="chrome"><b></b><b></b><b></b><span>fpa-fod.vercel.app</span></div>
        <div class="shot">
          <div class="side">
            <h4>Color by</h4>
            <div class="leg"><i style="background:#eb6834"></i>Human<span>●</span></div>
            <div class="leg"><i style="background:#2a78d6"></i>Natural<span>●</span></div>
            <div class="leg"><i style="background:#1baf7a"></i>Equipment<span>●</span></div>
            <div class="leg"><i style="background:#eda100"></i>Debris burning<span>●</span></div>
            <div class="leg"><i style="background:#e87ba4"></i>Arson<span>●</span></div>
            <h4 style="margin-top:20px">Year</h4>
            <div class="bar"></div>
            <h4>Size class</h4>
            <div class="bar"></div>
          </div>
          <div class="map">
            <svg viewBox="0 0 760 420" preserveAspectRatio="xMidYMid slice">
              {dots.map((d) => <circle class="dot" cx={d.x} cy={d.y} r={d.r} fill={d.c} fill-opacity="0.85" style={`animation-delay:-${d.d}s`} />)}
            </svg>
          </div>
        </div>
      </div>
    </section>

    <section class="wrap">
      <div class="stats">
        {stats.map(([n, l]) => <div class="stat glass reveal"><b>{n}</b><span>{l}</span></div>)}
      </div>
    </section>

    <section id="features" class="wrap">
      <div class="eyebrow">Features</div>
      <h2>Built for asking “why did this start?”</h2>
      <p class="sub">A browser-only explorer. No account, no backend, no waiting on a server to draw your filters.</p>
      <div class="grid">
        {features.map((f) => (
          <article class="card glass reveal">
            <div class="ic"><svg viewBox="0 0 24 24"><path d={f.i} /></svg></div>
            <h3>{f.t}</h3>
            <p>{f.d}</p>
          </article>
        ))}
      </div>
    </section>

    <section id="how" class="wrap">
      <div class="eyebrow">How it works</div>
      <h2>From map to answer in three steps</h2>
      <p class="sub">&nbsp;</p>
      <div class="steps">
        {steps.map((s) => <div class="step glass reveal"><h3>{s.t}</h3><p>{s.d}</p></div>)}
      </div>
    </section>

    <section id="data" class="wrap">
      <div class="data glass reveal">
        <div>
          <div class="eyebrow">The data</div>
          <h2 style="max-width:none">Wildfire Occurrence Data, FPA-FOD</h2>
          <p class="sub" style="margin-bottom:0">Compiled by the USDA Forest Service from federal, state and local fire reporting systems. This site is an independent viewer of the published dataset.</p>
          <div class="chips">
            <span class="chip">1992–2024</span><span class="chip">Point locations</span><span class="chip">NWCG cause codes</span><span class="chip">Open access</span>
          </div>
          <div class="cta" style="justify-content:flex-start;margin-top:22px">
            <a class="btn ghost sm" href={RDS_URL}>Dataset page</a>
            <a class="btn ghost sm" href={CITATION_DOI}>DOI</a>
          </div>
        </div>
        <blockquote>{CITATION_TEXT}</blockquote>
      </div>
    </section>

    <section class="wrap">
      <div class="final glass reveal">
        <h2>See where fires start.</h2>
        <p class="sub">Open the map and follow a cause across three decades.</p>
        <a class="btn primary" href={APP_URL}>Launch the app →</a>
      </div>
    </section>
  </main>

  <footer class="wrap">
    <span>Data: USFS Research Data Archive, RDS-2013-0009.7</span>
    <span><a href={APP_URL}>App</a> · <a href={REPO_URL}>Source</a></span>
  </footer>
</Base>
