# Public URL of the PMTiles file (layer "fod") on Cloudflare R2. Read-only; no R2 keys needed.
NEXT_PUBLIC_FOD_PMTILES_URL=https://pub-55bcb774b88f4b619636500860a70cb0.r2.dev/fod_fast.pmtiles
# Optional: Parquet of the same records with lon/lat (or LONGITUDE/LATITUDE) columns.
# Enables exact counts, charts and Parquet/CSV/GeoJSON downloads via DuckDB-WASM.
NEXT_PUBLIC_FOD_PARQUET_URL=
# Optional: MTBS burned-area perimeters (layer "mtbs", field event_id). Defaults to the R2 file below.
NEXT_PUBLIC_MTBS_PMTILES_URL=https://pub-55bcb774b88f4b619636500860a70cb0.r2.dev/mtbs.pmtiles
