# Required. Public URL of the PMTiles file (layer "fod") on Cloudflare R2.
NEXT_PUBLIC_FOD_PMTILES_URL=
# Optional. Public URL of a Parquet file with the same records and lon/lat columns.
# Enables exact counts, charts, and Parquet/CSV/GeoJSON downloads via DuckDB-WASM.
NEXT_PUBLIC_FOD_PARQUET_URL=
